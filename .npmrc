# pnpm 11 reads these from .npmrc / pnpm-workspace.yaml, not from package.json.
# esbuild is needed by Vitest and the Tailwind oxide binary by the CSS pipeline;
# both must run their install scripts or the builds fail.
only-built-dependencies[]=esbuild
only-built-dependencies[]=@tailwindcss/oxide
strict-dep-builds=false

# Never gate installs on a registry build-script audit prompt.
dangerously-allow-all-builds=false
