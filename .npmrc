# pnpm 11 reads build-script permissions from pnpm-workspace.yaml (`allowBuilds`).
# These npmrc entries are kept for older pnpm versions that still read them.
only-built-dependencies[]=esbuild
only-built-dependencies[]=@tailwindcss/oxide
# A missing postinstall must not fail the install; the workspace allowBuilds
# entry is what actually permits the scripts.
strict-dep-builds=false
