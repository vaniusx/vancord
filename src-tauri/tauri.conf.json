{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vancord",
  "version": "0.3.0",
  "identifier": "tr.ssyz.vancord",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vancord",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co http://localhost:1420 ws://localhost:1420 ws://localhost:1421;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Vancord",
    "shortDescription": "Vancord desktop client",
    "longDescription": "Vancord is a lightweight, fast desktop chat application for small groups of friends.",
    "category": "SocialNetworking",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCQjhFQjdGMEY2RUMxQUUKUldTdXdXNFBmK3U0bS9DcnUvazhOTGdNK1c0aEprcVpkaXIxREM0b0k2eU5YaWp2R2lCUWZIK0wK",
      "endpoints": [
        "https://github.com/vaniusx/vancord/releases/latest/download/latest.json"
      ]
    }
  }
}
